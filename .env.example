DATABASE_URL=sqlite:///./riverguard.db
DATA_DIR=./data
UPLOAD_DIR=./uploads
RIVER_PROXIMITY_M=500
ASSET_CORRIDOR_M=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=admin@123
ADMIN_SESSION_HOURS=8
# Set true with HTTPS in deployment.
COOKIE_SECURE=false
MAX_IMAGES_PER_REPORT=5
# Local development uses disk storage. On Vercel, leave STORAGE_BACKEND unset
# (it defaults to vercel_blob) or explicitly set it to vercel_blob.
# STORAGE_BACKEND=local
# BLOB_READ_WRITE_TOKEN=provided-by-your-connected-public-vercel-blob-store
# On Vercel set DATABASE_URL to the pooled Neon/Postgres URL, not SQLite.
